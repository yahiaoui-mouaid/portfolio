---
// A fixed background that tells one story as the page scrolls:
// raw data -> a fitted model -> training (accuracy goes up) -> serving requests.
// Sections mark where each chapter starts with data-stage="0..3".
const chapters = [
  { title: 'Raw data', text: 'Noisy and unstructured' },
  { title: 'Model', text: 'A trend emerges' },
  { title: 'Training', text: 'Accuracy goes up' },
  { title: 'Serving', text: 'Requests answered' },
];
---

<div class="story" aria-hidden="true" transition:persist="story-bg">
  <canvas data-story-canvas></canvas>
  <span class="probe probe-me"></span><span class="probe probe-ai"></span><span class="probe probe-line"></span><span class="probe probe-ink"></span>
</div>

<ol class="chapters" aria-label="Background story" transition:persist="story-chapters" data-story-chapters>
  {
    chapters.map((c, i) => (
      <li data-chapter={i}>
        <span class="bar"><span class="fill" /></span>
        <span class="c-title">{c.title}</span>
        <span class="c-text">{c.text}</span>
      </li>
    ))
  }
</ol>

<script>
  type Pt = { u: number; rx: number; ry: number; n: number; lane: number; ph: number; sp: number };

  const canvas = document.querySelector<HTMLCanvasElement>('[data-story-canvas]');
  const ctx = canvas?.getContext('2d');
  const chapterList = document.querySelector<HTMLElement>('[data-story-chapters]');

  if (canvas && ctx) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const N = 120;
    const LANES = 5;
    let W = 0;
    let H = 0;
    let s = 0; // story position, 0..3
    let target = 0;
    let anchors: number[] = [];
    let colors = { me: '#34e0a1', ai: '#a78bfa', line: '#263347', ink: '#e8eef6' };

    // Stable pseudo-random so the picture is the same on every visit.
    let seed = 7;
    const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
    const gauss = () => (rnd() + rnd() + rnd() - 1.5) / 1.5;
    const pts: Pt[] = Array.from({ length: N }, (_, i) => ({
      u: (i + rnd() * 0.8) / N,
      rx: rnd(),
      ry: rnd(),
      n: gauss(),
      lane: Math.floor(rnd() * LANES),
      ph: rnd() * Math.PI * 2,
      sp: 0.35 + rnd() * 0.65,
    }));

    const clamp = (v: number, a = 0, b = 1) => Math.min(Math.max(v, a), b);
    const ease = (t: number) => t * t * (3 - 2 * t);
    const mix = (a: number, b: number, t: number) => a + (b - a) * t;

    function readColors() {
      const box = canvas!.parentElement!;
      const get = (sel: string) => getComputedStyle(box.querySelector(sel)!).color;
      colors = { me: get('.probe-me'), ai: get('.probe-ai'), line: get('.probe-line'), ink: get('.probe-ink') };
    }
    const alpha = (c: string, a: number) => c.replace(/^rgb\(([^)]+)\)$/, `rgb($1 / ${a})`).replace(/, /g, ' ');

    function resize() {
      const dpr = Math.min(devicePixelRatio || 1, 1.5);
      W = innerWidth;
      H = innerHeight;
      canvas!.width = Math.round(W * dpr);
      canvas!.height = Math.round(H * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      measure();
    }

    function measure() {
      const els = Array.from(document.querySelectorAll<HTMLElement>('[data-stage]'));
      anchors = els
        .sort((a, b) => Number(a.dataset.stage) - Number(b.dataset.stage))
        .map((el) => el.getBoundingClientRect().top + scrollY);
      updateTarget();
    }

    function updateTarget() {
      if (anchors.length < 2) {
        // Pages without chapters (case studies) sit on the model chapter.
        target = 1;
        return;
      }
      const y = scrollY + innerHeight * 0.5;
      let v = 0;
      for (let i = 0; i < anchors.length - 1; i++) {
        if (y >= anchors[i]) v = i + clamp((y - anchors[i]) / (anchors[i + 1] - anchors[i]));
      }
      target = clamp(v, 0, anchors.length - 1);
    }

    // Where each point sits in each chapter (screen coordinates).
    const fitY = (u: number) => H * (0.8 - 0.55 * u);
    const curveY = (u: number) => H * (0.22 + 0.6 * Math.exp(-4.2 * u));
    const laneY = (l: number) => H * (0.2 + (0.6 * l) / (LANES - 1));
    const X0 = () => W * 0.06;
    const XW = () => W * 0.88;

    function drawGrid() {
      const step = 56;
      ctx!.strokeStyle = alpha(colors.line, 0.55);
      ctx!.lineWidth = 1;
      ctx!.beginPath();
      for (let x = (W % step) / 2; x < W; x += step) {
        ctx!.moveTo(x + 0.5, 0);
        ctx!.lineTo(x + 0.5, H);
      }
      for (let y = 0; y < H; y += step) {
        ctx!.moveTo(0, y + 0.5);
        ctx!.lineTo(W, y + 0.5);
      }
      ctx!.stroke();
    }

    function frame(time: number) {
      const t = time / 1000;
      const motion = !reduce.matches;
      s = motion ? s + (target - s) * 0.08 : target;

      const a = ease(clamp(s)); // raw -> model
      const b = ease(clamp(s - 1)); // model -> training
      const c = ease(clamp((s - 2.55) / 0.45)); // training -> serving, late in the last stretch

      ctx!.clearRect(0, 0, W, H);
      // Text covers more of a narrow screen, so the story stays quieter there.
      ctx!.globalAlpha = W < 700 ? 0.55 : 1;
      drawGrid();

      const x0 = X0();
      const xw = XW();

      // Model: confidence band narrows and the fitted line appears.
      const modelVis = a * (1 - c);
      if (modelVis > 0.01) {
        const band = H * mix(0.12, 0.035, a) * (1 - b);
        ctx!.fillStyle = alpha(colors.me, 0.06 * modelVis);
        ctx!.beginPath();
        ctx!.moveTo(x0, fitY(0) - band);
        ctx!.lineTo(x0 + xw, fitY(1) - band);
        ctx!.lineTo(x0 + xw, fitY(1) + band);
        ctx!.lineTo(x0, fitY(0) + band);
        ctx!.fill();
        ctx!.strokeStyle = alpha(colors.me, 0.45 * modelVis * (1 - b * 0.7));
        ctx!.lineWidth = 1.5;
        ctx!.beginPath();
        ctx!.moveTo(x0, fitY(0));
        ctx!.lineTo(x0 + xw * a, mix(fitY(0), fitY(1), a));
        ctx!.stroke();
      }

      // Training: the accuracy curve draws itself and climbs.
      const trainVis = b * (1 - c * 0.85);
      if (trainVis > 0.01) {
        ctx!.strokeStyle = alpha(colors.ai, 0.5 * trainVis);
        ctx!.lineWidth = 1.8;
        ctx!.beginPath();
        const steps = 90;
        for (let i = 0; i <= steps * b; i++) {
          const u = i / steps;
          const y = curveY(u);
          i === 0 ? ctx!.moveTo(x0 + xw * u, y) : ctx!.lineTo(x0 + xw * u, y);
        }
        ctx!.stroke();
      }

      // Serving: lanes from client to API to database.
      if (c > 0.01) {
        ctx!.strokeStyle = alpha(colors.line, 0.9 * c);
        ctx!.lineWidth = 1;
        ctx!.setLineDash([3, 6]);
        ctx!.beginPath();
        for (let l = 0; l < LANES; l++) {
          ctx!.moveTo(x0, laneY(l));
          ctx!.lineTo(x0 + xw, laneY(l));
        }
        ctx!.stroke();
        ctx!.setLineDash([]);
        const nodes = [
          { x: x0 + xw * 0.5, label: 'API' },
          { x: x0 + xw, label: 'DB' },
        ];
        ctx!.font = '600 11px "Geist Mono Variable", ui-monospace, monospace';
        ctx!.textAlign = 'center';
        for (const n of nodes) {
          ctx!.fillStyle = alpha(colors.me, 0.08 * c);
          ctx!.strokeStyle = alpha(colors.me, 0.45 * c);
          ctx!.beginPath();
          ctx!.roundRect(n.x - 26, laneY(0) - 30, 52, laneY(LANES - 1) - laneY(0) + 60, 12);
          ctx!.fill();
          ctx!.stroke();
          ctx!.fillStyle = alpha(colors.me, 0.7 * c);
          ctx!.fillText(n.label, n.x, laneY(0) - 40);
        }
      }

      // The data points move through every chapter.
      for (const p of pts) {
        const drift = motion ? Math.sin(t * 0.4 * p.sp + p.ph) : 0;
        const rawX = p.rx * W + drift * 14;
        const rawY = p.ry * H + Math.cos(t * 0.35 * p.sp + p.ph) * (motion ? 12 : 0);

        const fx = x0 + xw * p.u;
        const fy = fitY(p.u) + p.n * H * mix(0.1, 0.03, a);

        const lx = x0 + xw * p.u;
        const ly = curveY(p.u) + p.n * H * 0.018 * (1 - p.u);

        const flow = motion ? (p.u + t * 0.05 * p.sp) % 1 : p.u;
        const sx = x0 + xw * flow;
        const sy = laneY(p.lane);

        let x = mix(rawX, fx, a);
        let y = mix(rawY, fy, a);
        x = mix(x, lx, b);
        y = mix(y, ly, b);
        x = mix(x, sx, c);
        y = mix(y, sy, c);

        // Points ahead of the drawn loss curve wait until training reaches them.
        const visible = b > 0 && c < 0.5 && p.u > b ? 0.25 : 1;
        const col = c > 0.5 ? colors.me : b > 0.5 ? colors.ai : colors.ink;
        ctx!.fillStyle = alpha(col, mix(0.45, 0.55, a) * visible);
        ctx!.beginPath();
        ctx!.arc(x, y, c > 0.5 ? 2.3 : 2.1, 0, Math.PI * 2);
        ctx!.fill();
      }

      // Chapter progress in the corner.
      if (chapterList) {
        const fills = [1, a, b, c];
        const active = c > 0.5 ? 3 : b > 0.5 ? 2 : a > 0.5 ? 1 : 0;
        chapterList.querySelectorAll<HTMLElement>('[data-chapter]').forEach((li) => {
          const i = Number(li.dataset.chapter);
          li.style.setProperty('--fill', String(fills[i]));
          li.classList.toggle('on', active === i);
        });
      }

      if (motion) requestAnimationFrame(frame);
    }

    readColors();
    resize();
    s = target;
    addEventListener('resize', resize, { passive: true });
    addEventListener(
      'scroll',
      () => {
        updateTarget();
        if (reduce.matches) frame(0);
      },
      { passive: true },
    );
    // Re-read positions after page swaps, fonts and images change the layout.
    document.addEventListener('astro:page-load', () => {
      measure();
      s = target;
      chapterList?.classList.toggle('hidden', anchors.length < 2);
    });
    addEventListener('load', measure);
    new ResizeObserver(() => measure()).observe(document.body);
    new MutationObserver(() => {
      readColors();
      if (reduce.matches) frame(0);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    requestAnimationFrame(frame);
  }
</script>

<style>
  .story {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  canvas { width: 100%; height: 100%; display: block; }
  /* Hidden swatches the script reads resolved theme colours from */
  .probe { position: absolute; width: 0; height: 0; overflow: hidden; }
  .probe-me { color: var(--me); }
  .probe-ai { color: var(--ai); }
  .probe-line { color: var(--line-2); }
  .probe-ink { color: var(--ink-3); }

  .chapters {
    position: fixed;
    left: var(--gutter);
    bottom: 1.25rem;
    z-index: 40;
    display: flex;
    gap: 0.9rem;
    margin: 0;
    padding: 0.7rem 1rem;
    list-style: none;
    border-radius: 16px;
    background: color-mix(in oklch, var(--card) 78%, transparent);
    border: 1px solid var(--line-2);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    font-size: var(--t-xs);
    pointer-events: none;
  }
  .chapters.hidden { display: none; }
  .chapters li {
    display: grid;
    gap: 0.3rem;
    width: 5.25rem;
    color: var(--ink-3);
    transition: color 0.3s;
  }
  .chapters li.on { color: var(--ink); }
  .bar { height: 2px; border-radius: 2px; background: var(--line-2); overflow: hidden; }
  .fill { display: block; height: 100%; background: var(--me); transform-origin: left; transform: scaleX(var(--fill, 0)); }
  .c-title { font-weight: 650; }
  /* Only the current chapter shows its line, under the whole row */
  .chapters { padding-bottom: 1.9rem; }
  .c-text {
    position: absolute;
    left: 1rem;
    bottom: 0.65rem;
    color: var(--ink-2);
    opacity: 0;
    transition: opacity 0.3s;
    white-space: nowrap;
  }
  .chapters li.on .c-text { opacity: 1; }

  @media (max-width: 60rem) {
    .chapters { display: none; }
  }
</style>
